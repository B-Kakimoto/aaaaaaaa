---
/**
 * Layout.astro
 * ページ全体の共通テンプレートです。
 * 全ページ共通のhead情報・共通CSS・HTMLの外枠を管理します。
 *
 * 各ページの中身は <slot /> の位置に入ります。
 */

import "../styles/style.scss";

import Header from "../components/copy/Header.astro";
import Footer from "../components/copy/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "YONEDA HOTEL GROUP",
	description = "YONEDA HOTEL GROUPの公式サイトです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<!-- 文字化け防止 -->
		<meta charset="UTF-8" />
		<!-- スマホ・タブレット対応の基本設定 -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- リセットCSS（※ブラウザ間のズレをきれいに整える） -->
		<link rel="stylesheet" href="https://unpkg.com/ress/dist/ress.min.css" />

		<!-- ファビコン：ブラウザのタブに表示されるアイコン -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />

		<!-- Google Fontsの読み込み -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>

		<!-- ページタイトル -->
		<title>{title}</title>
		<!-- ページの説明文：検索結果やSNS表示で使われることがあります -->
		<meta name="description" content={description} />

		<!-- OGP設定：SNSなどで共有された時の表示情報 -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>

	<body>
		<Header />
		<!-- 各ページの中身がここに入ります -->
		<slot />
		<Footer />
	</body>
</html>
