---
import "../styles/layout/2footer.scss";
import Button from "../components/Button.astro";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>footer-テスト</title>
	</head>
	<body>
		<div class="container">
			<footer id="main">
				<div class="pc-only">
					<section class="pc-main">
						<section class="upco-flex">
							<div class="Headline">
								<h1 class="footer-h1">
									<a href="/">YONEDA HOTEL GROUP</a>
								</h1>
								<ul class="icon">
									<li>
										<img src="/SVG/Instagram.svg" alt="instagram" />
									</li>
									<li>
										<img src="/SVG/LINE.svg" alt="LINE" />
									</li>
								</ul>
							</div>
							<nav class="item">
								<Button href="#">itoshima810</Button>
								<Button href="#">itoshima808</Button>
								<Button href="#">Tamagawa4</Button>
								<Button href="#">Okusu3</Button>
								<Button href="#">Reserve｜予約</Button>
							</nav>
							<div class="Copyright">
								<p>Copyright &copy; YONEDA HOTEL GROUP All Rights Reserved.</p>
								<p>PRIVACY POLICY</p>
							</div>
						</section>
						<section class="Language">
							<nav>
								<a href="/jp">JP</a>
								<span>｜</span>
								<a href="/en">EN</a>
							</nav>
						</section>
						<aside class="TC-List">
							<ul class="text-list">
								<li><a href="#">ABOUT</a></li>
								<li><a href="#">PROJECT</a></li>
								<li><a href="#">CONTACT</a></li>
							</ul>
							<ul class="Company-List">
								<li><a href="#">ホテルづくりをお考えの方へ</a></li>
								<li><a href="#">米田建築工房</a></li>
								<li><a href="#">設計部門<br />TRUNK DESIGN OFFICE</a></li>
							</ul>
						</aside>
					</section>
				</div>

				<div class="sp-only">
					<section class="Headline-sp">
						<nav>
							<a href="/jp">JP</a>
							<span>｜</span>
							<a href="/en">EN</a>
						</nav>
						<h1 class="footer-h1-sp">
							<a class="Yoneda-url" href="/">YONEDA HOTEL GROUP</a>
						</h1>
						<nav class="item-sp">
							<Button href="#">itoshima810</Button>
							<Button href="#">itoshima808</Button>
							<Button href="#">Tamagawa4</Button>
							<Button href="#">Okusu3</Button>
							<Button href="#">Reserve｜予約</Button>
						</nav>
						<div class="column-text">
							<div class="text-icon-button-sp">
								<ul class="icon-sp">
									<li>
										<img src="/SVG/Instagram.svg" alt="instagram" />
									</li>
									<li>
										<img src="/SVG/LINE.svg" alt="LINE" />
									</li>
								</ul>
							</div>
							<ul class="text-list">
								<li><a href="#">ABOUT</a></li>
								<li><a href="#">PROJECT</a></li>
								<li><a href="#">CONTACT</a></li>
							</ul>
						</div>
					</section>
					<section class="CC-List">
						<ul class="Company-List-sp">
							<li><a href="#">ホテルづくりをお考えの方へ</a></li>
							<li><a href="#">米田建築工房</a></li>
							<li><a href="#">設計部門<br />TRUNK DESIGN OFFICE</a></li>
						</ul>
						<div class="Copyright-sp">
							<p>Copyright &copy; YONEDA HOTEL GROUP All Rights Reserved.</p>
							<p>PRIVACY POLICY</p>
						</div>
					</section>
				</div>
			</footer>
		</div>
	</body>
</html>
