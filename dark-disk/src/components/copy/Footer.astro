---
import "../../styles/layout/footer.scss";
import InstagramIcon from "../../image/SVG/Instagram.svg";
import LineIcon from "../../image/SVG/LINE_1.svg";
---

<footer id="main" class="footer">
  <div class="container pc-only">
    <div class="pc-main">
      <section class="upco-flex">
        <nav class="Headline">
          <h1 class="footer-h1">
            <a href="/">YONEDA HOTEL GROUP</a>
          </h1>
          <ul class="icon">
            <li>
              <a href="https://www.instagram.com/" target="_blank"
                ><img
                  src={InstagramIcon.src}
                  alt=""
                  class="header__sns-icon"
                /></a
              >
            </li>
            <li>
              <a href="https://line.me/..." target="_blank"
                ><img src={LineIcon.src} alt="" class="header__sns-icon" /></a
              >
            </li>
          </ul>
        </nav>
        <nav class="item">
          <ul>
            <li><a href="#">itoshima810</a></li>
            <li><a href="#">itoshima808</a></li>
            <li><a href="#">Tamagawa4</a></li>
            <li><a href="#">Okusu3</a></li>
            <li><a href="#">Reserve｜予約</a></li>
          </ul>
        </nav>
        <div class="Copyright">
          <p>Copyright &copy; YONEDA HOTEL GROUP All Rights Reserved.</p>
          <p>PRIVACY POLICY</p>
        </div>
      </section>
      <nav class="Language">
        <div class="footer__lang" id="langSwitch">
          <button
            type="button"
            class="footer__lang-btn is-active"
            data-lang="ja"
            aria-label="日本語に切り替え"
          >
            <svg
              class="footer__lang-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 18 13.07"
            >
              <path
                class="cls-4"
                d="M1.21,10.13c.1.5.32.93.68,1.27.35.34.82.51,1.4.51.44,0,.81-.08,1.1-.24.29-.16.52-.38.69-.66.17-.28.29-.59.36-.94s.1-.72.1-1.11V0h1.3v9.07c0,.42-.04.86-.13,1.33-.09.47-.26.9-.51,1.3-.25.4-.6.72-1.04.98-.44.26-1.01.39-1.71.39-.92,0-1.69-.25-2.29-.74s-.98-1.12-1.13-1.87l1.21-.32Z"
              ></path>
              <path
                class="cls-4"
                d="M10.1,0h3.6c.65,0,1.24.07,1.76.21.53.14.98.35,1.36.63.38.28.67.64.87,1.06.2.43.31.93.31,1.5s-.11,1.08-.32,1.5-.5.78-.88,1.06c-.38.28-.83.5-1.37.64-.53.14-1.12.22-1.77.22h-2.27v5.92h-1.3V0ZM11.39,5.72h2.2c1.02,0,1.79-.2,2.32-.59.53-.4.79-.97.79-1.73s-.27-1.37-.82-1.74c-.55-.37-1.31-.55-2.29-.55h-2.2v4.61Z"
              ></path>
            </svg>
          </button>
          <span class="footer__language-btn-divider" aria-hidden="true"></span>
          <button
            type="button"
            class="footer__lang-btn"
            data-lang="en"
            aria-label="Switch to English"
          >
            <svg
              class="footer__lang-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 21.02 12.74"
            >
              <path
                class="cls-3"
                d="M1.3,11.59h6.82v1.15H0V0h7.9v1.15H1.3v4.37h6.17v1.15H1.3v4.91Z"
              ></path>
              <path
                class="cls-3"
                d="M19.69,10.85h.04V0h1.3v12.74h-1.62L11.99,1.78h-.04v10.96h-1.3V0h1.62l7.42,10.85Z"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
      <aside class="TC-List">
        <ul class="text-list">
          <li><a href="#">ABOUT</a></li>
          <li><a href="#">PROJECT</a></li>
          <li><a href="#">CONTACT</a></li>
        </ul>
        <ul class="Company-List">
          <li><a href="#">ホテルづくりをお考えの方へ</a></li>
          <li><a href="#">米田建築工房</a></li>
          <li>
            <a href="#"><span>設計部門</span><br />TRUNK DESIGN OFFICE</a>
          </li>
        </ul>
      </aside>
    </div>
  </div>

  <div class="container sp-only">
    <section class="Headline-sp">
      <nav class="Language">
        <div class="footer__panel-lang" id="langSwitch">
          <button
            type="button"
            class="footer__lang-btn is-active"
            data-lang="ja"
            aria-label="日本語に切り替え"
          >
            <svg
              class="footer__lang-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 18 13.07"
            >
              <path
                class="cls-4"
                d="M1.21,10.13c.1.5.32.93.68,1.27.35.34.82.51,1.4.51.44,0,.81-.08,1.1-.24.29-.16.52-.38.69-.66.17-.28.29-.59.36-.94s.1-.72.1-1.11V0h1.3v9.07c0,.42-.04.86-.13,1.33-.09.47-.26.9-.51,1.3-.25.4-.6.72-1.04.98-.44.26-1.01.39-1.71.39-.92,0-1.69-.25-2.29-.74s-.98-1.12-1.13-1.87l1.21-.32Z"
              ></path>
              <path
                class="cls-4"
                d="M10.1,0h3.6c.65,0,1.24.07,1.76.21.53.14.98.35,1.36.63.38.28.67.64.87,1.06.2.43.31.93.31,1.5s-.11,1.08-.32,1.5-.5.78-.88,1.06c-.38.28-.83.5-1.37.64-.53.14-1.12.22-1.77.22h-2.27v5.92h-1.3V0ZM11.39,5.72h2.2c1.02,0,1.79-.2,2.32-.59.53-.4.79-.97.79-1.73s-.27-1.37-.82-1.74c-.55-.37-1.31-.55-2.29-.55h-2.2v4.61Z"
              ></path>
            </svg>
          </button>
          <span class="footer__language-btn-divider" aria-hidden="true"></span>
          <button
            type="button"
            class="footer__lang-btn"
            data-lang="en"
            aria-label="Switch to English"
          >
            <svg
              class="footer__lang-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 21.02 12.74"
            >
              <path
                class="cls-3"
                d="M1.3,11.59h6.82v1.15H0V0h7.9v1.15H1.3v4.37h6.17v1.15H1.3v4.91Z"
              ></path>
              <path
                class="cls-3"
                d="M19.69,10.85h.04V0h1.3v12.74h-1.62L11.99,1.78h-.04v10.96h-1.3V0h1.62l7.42,10.85Z"
              ></path>
            </svg>
          </button>
        </div>
      </nav>
      <h1 class="footer-h1-sp">
        <a class="Yoneda-url" href="/">YONEDA HOTEL GROUP</a>
      </h1>
      <nav class="item-sp">
        <ul>
          <li><a href="#">itoshima810</a></li>
          <li><a href="#">itoshima808</a></li>
          <li><a href="#">Tamagawa4</a></li>
          <li><a href="#">Okusu3</a></li>
          <li><a href="#">Reserve｜予約</a></li>
        </ul>
      </nav>
      <div class="column-text">
        <div class="text-icon-button-sp">
          <ul class="icon-sp">
            <li>
              <img src={InstagramIcon.src} alt="" class="header__sns-icon" />
            </li>
            <li>
              <img src={LineIcon.src} alt="" class="header__sns-icon" />
            </li>
          </ul>
        </div>
        <ul class="text-list">
          <li><a href="#">ABOUT</a></li>
          <li><a href="#">PROJECT</a></li>
          <li><a href="#">CONTACT</a></li>
        </ul>
      </div>
    </section>
    <section class="CC-List">
      <ul class="Company-List-sp">
        <li><a href="#">ホテルづくりをお考えの方へ</a></li>
        <li><a href="#">米田建築工房</a></li>
        <li>
          <a href="#"><span>設計部門</span><br />TRUNK DESIGN OFFICE</a>
        </li>
      </ul>
      <div class="Copyright-sp">
        <p>Copyright &copy; YONEDA HOTEL GROUP All Rights Reserved.</p>
        <p>PRIVACY POLICY</p>
      </div>
    </section>
  </div>
</footer>

<script>
  /**
   * 言語切替ボタンの処理
   */
  document.addEventListener("DOMContentLoaded", () => {
    const langButtons = document.querySelectorAll(".header__lang-btn");

    langButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        langButtons.forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
      });
    });
  });
</script>

