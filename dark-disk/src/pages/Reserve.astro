---
import Layout from "../Layouts/Layout2.astro";
import Card from "../pages/card.astro";
import "../styles/pages/Reserve.scss";

interface Props {
	text?: string;
}

const { text } = Astro.props;

interface Props {
	title?: string;
	href?: string;
}

const { title = "カードタイトル", href = "#" }: Props = Astro.props;
---

<Layout>
	<div id="Reserve-Block" class="Reserve-Site-area">
		<div class="Reserve-Site-area__text">
			<p class="Reserve-Site-area__decoration">Reserve｜予約</p>
		</div>
		<p class="Reserve-Site-area__text-2">
			<span class="Reserve-Site-area__pc-only"
				>{text} のご予約は下記リンク、予約サイトより。</span
			>
			<span class="Reserve-Site-area__sp-only"
				>{text} のご予約は<br />下記リンク、予約サイトより。</span
			>
			<span class="Reserve-Site-area__br"
				>詳細は各サイトにてご確認ください。</span
			>
		</p>
		<ul class="Reserve-Site-area__Card-area">
			<li><Card href="#" title="Airbub" /></li>
			<li><Card href="#" title="Rakuten<br>Oyado" /></li>
			<li><Card href="#" title="Booking.com" /></li>
		</ul>
	</div>
</Layout>

<a class="card" href={href}>
	<div class="card__content">
		<p class="card__title" set:html={title} />
	</div>

	<div class="card__button-area">
		<div class="card__btn">
			<img
				class="card__btn-icon"
				src="/src/assets/SVG/white-arrow.svg"
				alt=""
			/>
		</div>
	</div>
</a>
