---
import Layout from "../Layouts/Layout2.astro";
import "../styles/page2.scss";
import Button from "../components/Button.astro";
import ReserveButton from "../components/ReserveButton.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>page2</title>
  </head>
  <body>
    <main>
      <Layout>
        <section id="mainvisual-top1">
          <section class="mainvisual2">
            <div class="Project">
              <h2>PROJECT</h2>
              <nav class="item">
                <ul>
                  <li><img src="SVG/itoshima810.svg" alt="" /></li>
                  <li><img src="SVG/Itoshima808.svg" alt="" /></li>
                  <li>Tamagawa4</li>
                  <li>Okusu3</li>
                </ul>
              </nav>
              <nav class="button-group">
                <Button
                  href="/project/"
                  text="PROJECT 一覧"
                  variant="transparent"
                />
                <ReserveButton />
              </nav>
            </div>
            <div class="Movie">
              <h2>MOVIE</h2>
              <nav>
                <ul>
                  <li><img src="SVG/動画再生アイコン.svg" /></li>
                  <li>itoshima810 VILLA & RESORT</li>
                </ul>
                <ul>
                  <li><img src="SVG/動画再生アイコン.svg" /></li>
                  <li>Itoshima808 GRAND VIEW VILLA</li>
                </ul>
              </nav>
            </div>
          </section>
          <section class="mainvisual1">
            <h1 class="heading">
              ただ泊まるだけではない、<br />記憶に残るひとときを。
            </h1>

            <p class="gradation">
              時間とともに表情を変える空間の中で、<br
              />気持ちがゆるやかにほどけていく。<br
              />日常から少し離れ、ただ過ぎゆく時を愉しむ。<br
              />その場所ごとに込めた思いと心地よさが溶け合う、<br
              />くつろぎの滞在をお楽しみください。
            </p>
          </section>
        </section>

        <section id="mainvisual-top2">
          <section class="media">
            <h2>MEDIA</h2>
            <nav>
              <ul>
                <li></li>
                <li>掲載雑誌名</li>
              </ul>
              <ul>
                <li></li>
                <li>掲載雑誌名</li>
              </ul>
            </nav>
          </section>

          <section class="STAY-in-DESIGN">
            <div class="scroll-infinity">
              <div class="scroll-infinity__wrap">
                <ul class="scroll-infinity__list scroll-infinity__list--left">
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-1.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-2.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-3.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-4.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-5.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-6.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-7.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-8.webp" />
                  </li>
                </ul>
                <ul class="scroll-infinity__list scroll-infinity__list--left">
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-1.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-2.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-3.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-4.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-5.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-6.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-7.webp" />
                  </li>
                  <li class="scroll-infinity__item">
                    <img src="/images/2-slide-8.webp" />
                  </li>
                </ul>
              </div>
            </div>

            <h1>STAY in DESIGN.</h1>
            <p>produced by<br /><img src="SVG/designoffice.svg" alt="" /></p>
            <p class="short-sentence">
              設計事務所ならではの視点で、デザイン性と居心地の良さ、<span
                class="br"
              ></span>そして日常から少し離れる非日常感を大切にしています。
            </p>
            <nav>
              <ul>
                <li>
                  <Button href="/about/" text="ABOUT" variant="transparent" />
                </li>
                <li>
                  <a href="#"><p>ホテルづくりをお考えの方へ</p><p>&gt;</p></a>
                </li>
              </ul>
            </nav>
            <img class="" src="" alt="" />
          </section>
        </section>
      </Layout>
      <p>テストリンク<a href="/test">TEST</a></p>
      <p>テストリンク<a href="/index2">index2</a></p>
      <p>テストリンク<a href="/page2">page2</a></p>
    </main>
  </body>
</html>
