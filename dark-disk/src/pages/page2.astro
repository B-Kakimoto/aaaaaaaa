---
import Layout from "../Layouts/Layout2.astro";
import "../styles/page2.scss";
import Button from "../components/Button.astro";
import ReserveButton from "../components/ReserveButton.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>page2</title>
  </head>
  <body>
    <main>
      <Layout>
        <section class="mainvisual-top1">
          <section class="mainvisual2">
            <div class="Project">
              <h2>PROJECT</h2>
              <nav class="item">
                <ul>
                  <li><img src="SVG/itoshima810.svg" alt="" /></li>
                  <li><img src="SVG/Itoshima808.svg" alt="" /></li>
                  <li>Tamagawa4</li>
                  <li>Okusu3</li>
                </ul>
              </nav>
              <nav class="button-group">
                <Button
                  href="/project/"
                  text="PROJECT 一覧"
                  variant="transparent"
                />
                <ReserveButton />
              </nav>
            </div>
            <div class="Movie">
              <h2>MOVIE</h2>
            </div>
          </section>
          <section class="mainvisual1">
            <h1 class="heading">
              ただ泊まるだけではない、<br />記憶に残るひとときを。
            </h1>

            <p class="gradation">
              時間とともに表情を変える空間の中で、<br
              />気持ちがゆるやかにほどけていく。<br
              />日常から少し離れ、ただ過ぎゆく時を愉しむ。<br
              />その場所ごとに込めた思いと心地よさが溶け合う、<br
              />くつろぎの滞在をお楽しみください。
            </p>
          </section>
        </section>
      </Layout>
      <p>テストリンク<a href="/test">TEST</a></p>
      <p>テストリンク<a href="/index2">index2</a></p>
      <p>テストリンク<a href="/page2">page2</a></p>
    </main>
  </body>
</html>
