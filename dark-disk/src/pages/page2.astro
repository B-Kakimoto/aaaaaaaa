---
import Layout from "../Layouts/Layout2.astro";
// Layout.astro = ページの共通テンプレ（外枠）
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
import "../styles/page2.scss";
import Button from "../components/Button.astro";
import ReserveButton from "../components/ReserveButton.astro";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const svg = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("/src/assets/SVG/*.svg", {
    eager: true,
  }),
);
---

<Layout>
  <main>
    <section id="mainvisual-top1" class="top-page">
      <div class="top-page__mainvisual2">
        <div class="top-page__Project">
          <h2 class="top-page__m2-h2">PROJECT</h2>
          <div class="top-page__item">
            <ul class="top-page__svg top-page__svg--first">
              {
                svg.map((image) => (
                  <li class="top-page__project-list1 top-page__li-list">
                    <Image
                      class="top-page__item-svg"
                      src={image.default}
                      alt=""
                    />
                  </li>
                ))
              }
              {
                svg.map((image) => (
                  <li class="top-page__project-list1 top-page__li-list">
                    <Image
                      class="top-page__item-svg"
                      src={image.default}
                      alt=""
                    />
                  </li>
                ))
              }
            </ul>
            <ul class="top-page__svg top-page__svg--second">
              <li class="top-page__project-list2 top-page__li-list">
                Tamagawa4
              </li>
              <li class="top-page__project-list2 top-page__li-list">Okusu3</li>
            </ul>
          </div>
          <div class="top-page__button-group">
            <Button
              href="/project/"
              text="PROJECT 一覧"
              variant="transparent"
            />
            <ReserveButton />
          </div>
        </div>
        <div class="top-page__Movie">
          <h2 class="top-page__m2-h2">MOVIE</h2>
          <div class="top-page__movie-svg">
            <ul class="top-page__movie-svg-list">
              <li class="top-page__movie-list top-page__li-list">
                <img
                  class="top-page__movie-icon"
                  src="/src/image/SVG/動画再生アイコン.svg"
                />
              </li>
              <li class="top-page__movie-list top-page__li-list">
                itoshima810 VILLA & RESORT
              </li>
            </ul>
            <ul class="top-page__movie-svg-list">
              <li class="top-page__movie-list top-page__li-list">
                <img
                  class="top-page__movie-icon"
                  src="/src/image/SVG/動画再生アイコン.svg"
                />
              </li>
              <li class="top-page__movie-list top-page__li-list">
                Itoshima808 GRAND VIEW VILLA
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="top-page__mainvisual1">
        <h1 class="top-page__heading">
          ただ泊まるだけではない、<br />記憶に残るひとときを。
        </h1>

        <p class="top-page__text">
          時間とともに表情を変える空間の中で、<br
          />気持ちがゆるやかにほどけていく。<br
          />日常から少し離れ、ただ過ぎゆく時を愉しむ。<br
          />その場所ごとに込めた思いと心地よさが溶け合う、<br
          />くつろぎの滞在をお楽しみください。
        </p>
      </div>
    </section>

    <section id="mainvisual-top2" class="top-page">
      <div class="top-page__media">
        <h2 class="top-page__media-h2">MEDIA</h2>
        <div class="top-page__magazine">
          <ul class="top-page__magazine-list">
            <li></li>
            <li>掲載雑誌名</li>
          </ul>
          <ul class="top-page__magazine-list">
            <li></li>
            <li>掲載雑誌名</li>
          </ul>
        </div>
      </div>

      <div class="top-page__STAY-in-DESIGN">
        <div class="top-page__scroll-infinity">
          <div class="top-page__scroll-infinity__wrap">
            <ul
              class="top-page__scroll-infinity__list top-page__scroll-infinity__list--left"
            >
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-1.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-2.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-3.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-4.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-5.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-6.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-7.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-8.webp" />
              </li>
            </ul>
            <ul
              class="top-page__scroll-infinity__list top-page__scroll-infinity__list--left"
            >
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-1.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-2.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-3.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-4.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-5.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-6.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-7.webp" />
              </li>
              <li class="top-page__scroll-infinity__item">
                <img src="/src/image/top/2-slide-8.webp" />
              </li>
            </ul>
          </div>
        </div>

        <div class="top-page__text-area">
          <h1>STAY in DESIGN.</h1>
          <p>
            <span>
              produced by<br /><img
                src="/src/image/top/designoffice.svg"
                alt=""
              />
            </span>
          </p>
          <p class="top-page__short-sentence pc-only">
            設計事務所ならではの視点で、デザイン性と居心地の良さ、<span
              class="br"
            ></span>そして日常から少し離れる非日常感を大切にしています。
          </p>
          <p class="top-page__short-sentence sp-only">
            設計事務所ならではの視点で、<br />デザイン性と居心地の良さ、<br
            />そして日常から少し離れる<br />非日常感を大切にしています。
          </p>

          <ul class="top-page__footer-about">
            <li class="top-page__about-li">
              <Button href="/about/" text="ABOUT" variant="transparent" />
            </li>
            <li class="top-page__about-li">
              <a href="#"><p>ホテルづくりをお考えの方へ</p><p>&gt;</p></a>
            </li>
          </ul>
        </div>
        <img
          class="bottom-image pc-only"
          src="/src/image/top/2-about.webp"
          alt=""
        />
        <img
          class="bottom-image sp-only"
          src="/src/image/top/2-about-sp.webp"
          alt=""
        />
      </div>
    </section>
  </main>
</Layout>
